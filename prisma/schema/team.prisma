model Team {
  id       Int     @id @default(autoincrement())
  leagueId Int
  name     String
  abbr     String
  color    String  @default("#2563EB")
  logo     String?

  // Which half of the league the team plays in. Assigned when the team is
  // created, alternating, so a league is balanced without anybody having to
  // think about it; the commissioner can move a team afterwards.
  conference Conference @default(east)

  // Optional. When a league has no divisions the standings table's Div
  // column falls back to the team's record inside its conference, which is
  // the only other grouping there is.
  division  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  league          League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  leaguePlayers   LeaguePlayer[]
  contracts       Contract[]
  deadMoney       DeadMoney[]
  capHolds        CapHold[]
  importRows      ImportRow[]
  faOffers        FreeAgencyOffer[]
  tradeTeams      TradeTeam[]
  tradeAssetsOut  TradeAsset[]      @relation("tradeAssetsOut")
  tradeAssetsIn   TradeAsset[]      @relation("tradeAssetsIn")
  tradeExceptions TradeException[]

  draftOrderSlots  DraftOrderSlot[]
  draftPicksOrigin DraftPick[]       @relation("draftPicksOriginal")
  draftPicksHeld   DraftPick[]       @relation("draftPicksCurrent")
  draftPicksOwed   DraftPick[]       @relation("draftPicksOwed")
  pickEventsFrom   DraftPickEvent[]  @relation("pickEventsFrom")
  pickEventsTo     DraftPickEvent[]  @relation("pickEventsTo")
  hardCaps         TeamHardCap[]
  matchupsHome     Matchup[]         @relation("matchupsHome")
  matchupsAway     Matchup[]         @relation("matchupsAway")
  matchupsWon      Matchup[]         @relation("matchupsWon")
  matchupStats     MatchupTeamStat[]

  @@unique([leagueId, name])
  @@unique([leagueId, abbr])
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  teamId    Int
  leagueId  Int
  role      TeamRole @default(owner)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@unique([userId, leagueId])
  @@index([teamId, role])
}
