model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  name            String
  phone           String
  image           String?
  password        String
  role            Role     @default(user)
  isDeleted       Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdLeagues    League[]
  leagueMemberships LeagueMember[]
  teamMemberships   TeamMember[]
  contentUpdates    LeagueContent[]
  notifications     Notification[]

  leagueInvitesReceived LeagueInvite[]    @relation("leagueInvitesReceived")
  leagueInvitesSent     LeagueInvite[]    @relation("leagueInvitesSent")
  playerAliasesCreated  PlayerAlias[]     @relation("playerAliasesCreated")
  importBatchesUploaded ImportBatch[]     @relation("importBatchesUploaded")
  freeAgencyOffersMade  FreeAgencyOffer[] @relation("freeAgencyOffersMade")
  tradesProposed        Trade[]           @relation("tradesProposed")
  tradesApproved        Trade[]           @relation("tradesApproved")
  tradeResponses        TradeTeam[]       @relation("tradeResponses")
}
