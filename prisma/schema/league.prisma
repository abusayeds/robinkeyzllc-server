model League {
  id          Int              @id @default(autoincrement())
  name        String
  logo        String?
  teamCount   Int              @default(12)
  scoringType ScoringType      @default(headToHead9Cat)
  draftType   DraftType        @default(snake)
  visibility  LeagueVisibility @default(private)
  season      String
  createdById Int
  isDeleted   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  createdBy       User                  @relation(fields: [createdById], references: [id])
  members         LeagueMember[]
  teams           Team[]
  teamMembers     TeamMember[]
  contents        LeagueContent[]
  settings        LeagueSettings?
  calendarEvents  LeagueCalendarEvent[]
  notifications   Notification[]
  invites         LeagueInvite[]
  leaguePlayers   LeaguePlayer[]
  contracts       Contract[]
  deadMoney       DeadMoney[]
  capHolds        CapHold[]
  importBatches   ImportBatch[]
  faOffers        FreeAgencyOffer[]
  trades          Trade[]
  tradeExceptions TradeException[]

  @@index([createdById])
  @@index([visibility, isDeleted])
}

model LeagueMember {
  id        Int        @id @default(autoincrement())
  userId    Int
  leagueId  Int
  role      LeagueRole @default(member)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
  @@index([leagueId, role])
}
