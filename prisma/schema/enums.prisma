// Article 4 — the two ceilings a move can buy. Distinct from
// HardCapThreshold below, which is a league-wide commissioner option.
enum HardCapApron {
  firstApron
  secondApron
}

// Rule 4.2 — every move in the table, named so the cap page can say which
// one bought the ceiling.
enum HardCapTrigger {
  tookBackMoreSalary
  signAndTradeAcquisition
  tradeExceptionBelowFirstApron
  nonTaxpayerMleAboveTaxpayerAmount
  nonTaxpayerMleTradeOrClaim
  biAnnualException
  waivedPlayerAboveMle
  aggregatedSalaries
  tradeExceptionBetweenAprons
  taxpayerMle
  signAndTradeSendOut
}

enum HardCapThreshold {
  none
  luxuryTax
  firstApron
  secondApron
}

