// Help, Privacy, Terms and About, written per league by its commissioner.
// A league with no row of a type falls back to the platform-wide Management
// row of the same name, so a new league is never blank.
model LeagueContent {
  id          Int               @id @default(autoincrement())
  leagueId    Int
  type        LeagueContentType
  description String
  updatedById Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  league    League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([leagueId, type])
  @@index([updatedById])
}

// One post on the League News page, for every transaction the league makes.
//
// Stored rather than derived: a commissioner may override the headline, and
// the cap figures either side of a move are only true at the moment it
// happened. Reading them live would make an old post show today's payroll.
model LeagueNewsItem {
  id       Int @id @default(autoincrement())
  leagueId Int

  type NewsItemType
  // Not shown yet. It is here so a tier like "Blockbuster" can be added later
  // without a schema change.
  tier NewsItemTier @default(standard)

  // Built from the data when the item is written. The commissioner's own
  // headline wins over it when one is set.
  autoHeadline   String
  customHeadline String?

  // What each team received, the contract terms, and payroll before and after
  // per team — everything the template needs to lay itself out.
  payload Json

  // What produced it. The pair is unique so a move reprocessed, or an
  // approval retried, cannot post the same news twice.
  sourceType NewsItemSource
  sourceId   Int

  createdAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([leagueId, sourceType, sourceId])
  @@index([leagueId, createdAt])
}
