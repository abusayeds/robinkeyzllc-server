# এই file-টা GitHub-এ যায়। এখানে কখনো আসল password বা secret রাখবেন না।
# নতুন computer-এ: এই file copy করে .env নাম দিন, তারপর মান বসান।

# ---- Development (docker compose up -d চালানোর পর) ----
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/robinkeyz"
DIRECT_URL="postgresql://postgres:postgres123@localhost:5432/robinkeyz"
REDIS_HOST="localhost"
REDIS_PORT=6379

# ---- App ----
PORT=7000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
JWT_SECRET="এখানে-একটা-লম্বা-random-লেখা-বসান"
JWT_EXPIRES_IN="7d"

# ---- শুধু VPS/Production-এ লাগবে (docker-compose.prod.yml এগুলো পড়ে) ----
POSTGRES_PASSWORD="একটা-শক্তিশালী-password"
POSTGRES_DB="robinkeyz"
